# Copy to .env.local for development. Never commit real tokens.

# Base URL of the CRM API. Leave empty when the backend serves this UI from the
# same origin (production). In development the Vite proxy forwards /crm, /health
# and /__agente to VITE_DEV_PROXY_TARGET, so this can stay empty there too.
VITE_API_BASE_URL=

# Where the Vite dev server proxies API calls (development only).
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Bearer token the UI sends on every API call. If empty, the UI asks for it on
# first load and keeps it in localStorage.
VITE_CRM_TOKEN=

# Set to "true" to run the UI against in-memory demo data instead of the API.
# Development only: the production build ignores it unless explicitly set.
VITE_USE_MOCKS=false
